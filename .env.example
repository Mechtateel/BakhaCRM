# Bakha CRM — environment variables example
# Copy to .env and fill in real values. Never commit .env to Git.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
DATABASE_URL=file:./data/bakha-crm.sqlite
# "demo" uses fallback data; "real" uses imported AmoCRM data
DATA_MODE=demo
WEB_ORIGIN=http://localhost:5173

# ── WAPPI / WhatsApp ─────────────────────────────────────────────────────────
WAPPI_ENABLED=false
WAPPI_DRY_RUN=true
WAPPI_API_BASE_URL=https://wappi.pro
WAPPI_TOKEN=
WAPPI_PROFILE_ID=
WAPPI_WEBHOOK_SECRET=

# ── onlinePBX Telephony ───────────────────────────────────────────────────────
# Set ENABLED=true and DRY_RUN=false only after manager extensions are configured.
ONLINEPBX_ENABLED=false
ONLINEPBX_DRY_RUN=true
ONLINEPBX_API_BASE_URL=https://api2.onlinepbx.ru
# Your onlinePBX subdomain (e.g. "yourcompany" for yourcompany.onlinepbx.ru)
ONLINEPBX_DOMAIN=
# API key from onlinePBX admin → API section. NEVER expose to frontend.
ONLINEPBX_API_KEY=
# Shared secret for verifying incoming webhooks. Generate a random string.
ONLINEPBX_WEBHOOK_SECRET=

# ── AmoCRM import ─────────────────────────────────────────────────────────────
AMO_IMPORT_DB_PATH=

# ── AI Manager Bridge ─────────────────────────────────────────────────────────
# Master switch. false = no AI calls, messages saved normally.
AI_MANAGER_ENABLED=false
# true = simulate realistic AI reply locally without calling external server.
AI_MANAGER_DRY_RUN=true
# Base URL of the external AI Manager server (e.g. https://ai.yourdomain.com).
AI_MANAGER_BASE_URL=
# Endpoint path on the AI Manager server.
AI_MANAGER_ENDPOINT=/api/incoming-message
# Bearer token for AI Manager API auth. NEVER expose to frontend. NEVER log.
AI_MANAGER_API_KEY=
# false = AI reply saved as draft/suggestion; manager approves manually.
# true  = AI reply is sent automatically if confidence >= AI_MANAGER_MIN_CONFIDENCE.
AI_MANAGER_AUTO_SEND=false
# false = suggested CRM actions require manager approval.
AI_MANAGER_AUTO_ACTIONS=false
# true = manager manual reply temporarily pauses AI for this conversation.
AI_MANAGER_PAUSE_ON_MANAGER_REPLY=true
# Minutes to pause AI after a manager replies manually.
AI_MANAGER_PAUSE_MINUTES=30
# Minimum confidence score (0.0–1.0) required for auto-send.
AI_MANAGER_MIN_CONFIDENCE=0.75
