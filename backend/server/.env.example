# Bakha CRM — Backend Environment Variables
#
# ╔══════════════════════════════════════════════════════════════════════╗
# ║  IMPORTANT: Copy this file to backend/server/.env                   ║
# ║  The backend reads .env from backend/server/ (this directory).      ║
# ║  NEVER commit backend/server/.env — it is .gitignored.              ║
# ╚══════════════════════════════════════════════════════════════════════╝
#
# Copy command:
#   cp backend/server/.env.example backend/server/.env
# (Windows)
#   copy backend\server\.env.example backend\server\.env

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
DATABASE_URL=file:./data/bakha-crm.sqlite
# "demo" uses fallback data; "real" uses imported AmoCRM data
DATA_MODE=demo
WEB_ORIGIN=http://localhost:5173

# ── WAPPI / WhatsApp ──────────────────────────────────────────────────────────
#
# Safe staging order:
#   1. Set WAPPI_ENABLED=true, WAPPI_DRY_RUN=true first.
#      Restart backend. Run: POST /api/wappi/test-connection
#      Confirm dry-run OK.
#   2. Only after confirming, set WAPPI_DRY_RUN=false for real sends.
#
# NEVER enable WAPPI_AUTO_SEND or AI_MANAGER_AUTO_SEND without explicit review.
#
WAPPI_ENABLED=false
WAPPI_DRY_RUN=true
WAPPI_API_BASE_URL=https://wappi.pro

# ── Where to find WAPPI credentials ──────────────────────────────────────────
#
# WAPPI_TOKEN:
#   Your WAPPI API token (Bearer token).
#   Find it in: WAPPI dashboard → Profile → API → Token (or API key).
#   Format: a long alphanumeric string, e.g. "abc123def456..."
#   NEVER commit this value.
#
WAPPI_TOKEN=

# WAPPI_PROFILE_ID:
#   Your WAPPI profile identifier — the WhatsApp account profile you created
#   on WAPPI.pro for this CRM number.
#   Find it in: WAPPI dashboard → Profiles → click your profile → API or Settings.
#   The profile_id may look like: "a1b2c3d4-e5f6-..." (UUID) or a short name.
#
#   NOTE: The profile_id in the dashboard URL (e.g. /profile/12345) MAY match,
#   but prefer copying it from the "API" or "Integration" tab of that profile
#   page to be certain. The numeric ID in the URL is not always the profile_id
#   used in API calls.
#
WAPPI_PROFILE_ID=

# WAPPI_WEBHOOK_SECRET:
#   Optional shared secret to verify incoming webhook signatures.
#   If WAPPI does not use a secret, leave empty — all webhooks will be accepted.
#   If WAPPI allows you to set a secret, put the same value here and in the
#   WAPPI dashboard webhook configuration.
#   Generate a random value: openssl rand -hex 32
#
WAPPI_WEBHOOK_SECRET=

# ── onlinePBX Telephony ───────────────────────────────────────────────────────
ONLINEPBX_ENABLED=false
ONLINEPBX_DRY_RUN=true
ONLINEPBX_API_BASE_URL=https://api2.onlinepbx.ru
ONLINEPBX_DOMAIN=
ONLINEPBX_API_KEY=
ONLINEPBX_WEBHOOK_SECRET=

# ── AmoCRM import ─────────────────────────────────────────────────────────────
AMO_IMPORT_DB_PATH=

# ── AI Manager Bridge ─────────────────────────────────────────────────────────
AI_MANAGER_ENABLED=false
AI_MANAGER_DRY_RUN=true
AI_MANAGER_BASE_URL=
AI_MANAGER_ENDPOINT=/api/incoming-message
AI_MANAGER_API_KEY=
AI_MANAGER_AUTO_SEND=false
AI_MANAGER_AUTO_ACTIONS=false
AI_MANAGER_PAUSE_ON_MANAGER_REPLY=true
AI_MANAGER_PAUSE_MINUTES=30
AI_MANAGER_MIN_CONFIDENCE=0.75
